" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc
"
" Mirrors: github.com/ivanbiljan/dotfiles -> .mydotfiles/winhlp64/.config/nvim
"   opts.lua, remaps.lua, after/plugin/telescope.lua, plugins/nvimlspconfig.lua


"" -- Options (opts.lua) --
set scrolloff=8
set noshowmatch           " don't jump to matching bracket on insert
set ignorecase            " ignore case in search patterns
set mouse=a               " enable mouse in all modes
set hlsearch              " highlight search results
set incsearch             " incremental search
set tabstop=4             " number of columns per tab
set softtabstop=4         " treat multiple spaces as tabstops for backspace
set expandtab             " convert tabs to spaces
set shiftwidth=4          " width for autoindents
set autoindent            " indent new line same as previous
set number relativenumber " hybrid line numbers
set wildmode=longest,list " bash-like tab completion
set clipboard=unnamedplus " use system clipboard
set ttyfast               " speed up scrolling
set nofoldenable          " disable folding
set foldmethod=manual     " manual fold method
set foldlevelstart=120    " start with folds open
set nowrap                " disable line wrap
set wildignore=.hg,.snv,*~,*.png,*.jpg,*.gif,*.min.js,*.swp,*.o,vendor,dist,_site

" syntax highlighting is always on in IdeaVim
" diagnostics.lua (virtual_text) has no IdeaVim equivalent - the IDE renders inspections itself


"" -- Leader --
let mapleader = " "


"" -- Plugins --
" Highlight copied text
Plug 'machakann/vim-highlightedyank'
" Commentary plugin
Plug 'tpope/vim-commentary'
" Vim keys in the Project tool window (j/k, o, p, x, n/N, d, /, q ...)
Plug 'preservim/nerdtree'


"" -- General keymaps (remaps.lua) --
map Q gq

" Save
nmap <leader>w :w<CR>

" Project view (nvim: <leader>pv -> netrw :Ex)
map <leader>pv <Action>(ActivateProjectToolWindow)

" Escape with C-j in all modes
noremap  <C-j> <Esc>
inoremap <C-j> <Esc>
cnoremap <C-j> <Esc>

" C-k: in nvim the LspAttach buffer-local map (signature help in n/i/v) overrides
" the global <Esc> map in every code buffer, so it's signature help here too.
" Escape is kept only for the command line.
nmap <C-k> <Action>(ParameterInfo)
imap <C-k> <Action>(ParameterInfo)
vmap <C-k> <Action>(ParameterInfo)
cnoremap <C-k> <Esc>

" Disable arrow keys to force hjkl
nnoremap <up>    <nop>
nnoremap <down>  <nop>
inoremap <up>    <nop>
inoremap <down>  <nop>
inoremap <left>  <nop>
inoremap <right> <nop>

" Move by visual line when text is soft-wrapped, and center after motions
nnoremap j gjzz
nnoremap k gkzz
nnoremap G Gzz
nnoremap # #zz
nnoremap * *zz
nnoremap w wzz
nnoremap W Wzz
nnoremap e ezz
nnoremap E Ezz
nnoremap b bzz
nnoremap B Bzz
nnoremap H Hzz
nnoremap L Lzz
nnoremap 0 0zz
nnoremap $ $zz
nnoremap ^ ^zz
nnoremap u uzz
nnoremap ( (zz
nnoremap ) )zz
nnoremap { {zz
nnoremap } }zz
nnoremap [{ [{zz
nnoremap ]} ]}zz
nnoremap <C-D> <C-D>zz
nnoremap <C-U> <C-U>zz


"" -- Windows / splits (nvim defaults) --
" Give Vim the <C-w> prefix instead of the IDE's Extend Selection (also keeps insert-mode <C-w>)
sethandler <C-w> a:vim

" Built into IdeaVim 2.39+, no mappings needed - listed here as a reference:
"   <C-w>s  :sp        split horizontally          <C-w>v  :vs    split vertically
"   <C-w>c  <C-w>q     close split                 <C-w>o  :on    close all other splits
"   <C-w>h/j/k/l       move to split               <C-w>w  <C-w>W next / previous split
"   <C-w>+  <C-w>-     taller / shorter            <C-w>>  <C-w>< wider / narrower
"   <C-w>_  <C-w>|     maximize height / width     <C-w>=         equalize sizes
"   :resize [+-]N      :vertical resize [+-]N

" Not built in - closest IDE actions
" <C-w>p: previous window (cycles; same as Vim's with two splits)
nmap <C-w>p      <Action>(PrevSplitter)
nmap <C-w><C-p>  <Action>(PrevSplitter)
" <C-w>x: exchange - moves the current file into the other split
nmap <C-w>x      <Action>(MoveEditorToOppositeTabGroup)
nmap <C-w><C-x>  <Action>(MoveEditorToOppositeTabGroup)
" <C-w>H/J/K/L: move window to an edge - the IDE can only flip the split orientation
nmap <C-w>H      <Action>(ChangeSplitOrientation)
nmap <C-w>J      <Action>(ChangeSplitOrientation)
nmap <C-w>K      <Action>(ChangeSplitOrientation)
nmap <C-w>L      <Action>(ChangeSplitOrientation)


"" -- Terminal --
" Toggle the terminal tool window (toggleterm.nvim's default key)
sethandler <C-\> a:vim
nmap <C-\> <Action>(ActivateTerminalToolWindow)
imap <C-\> <Action>(ActivateTerminalToolWindow)
vmap <C-\> <Action>(ActivateTerminalToolWindow)


"" -- Search (after/plugin/telescope.lua) --
" Find files (nvim: git_files with find_files fallback / <C-p> find_files)
map <leader>pf <Action>(GotoFile)
map <C-p>      <Action>(GotoFile)
" Grep across the project (nvim: grep_string with prompt)
map <leader>ps <Action>(FindInPath)


"" -- LSP (plugins/nvimlspconfig.lua) --
" Go to definition (nvim: Telescope lsp_definitions)
nmap gd <Action>(GotoDeclaration)
" Go to declaration (nvim: vim.lsp.buf.declaration) - closest IDE match is the type declaration
nmap gD <Action>(GotoTypeDeclaration)
" Show references (nvim: Telescope lsp_references)
nmap gR <Action>(FindUsages)
" Show implementations (nvim: Telescope lsp_implementations)
nmap gi <Action>(GotoImplementation)
" Hover documentation
nmap K <Action>(QuickJavaDoc)
" Rename symbol
nmap <leader>rs <Action>(RenameElement)
" Code actions
nmap <leader>ca <Action>(ShowIntentionActions)
vmap <leader>ca <Action>(ShowIntentionActions)
" Toggle inlay hints
nmap <leader>ih <Action>(ToggleInlayHintsGloballyAction)
" Format code
nmap <leader>fc <Action>(ReformatCode)


"" -- IDE-only keymaps (no nvim counterpart, kept from previous config) --
" Code Cleanup: Ctrl+E then Ctrl+C (chord sequence)
map <C-E><C-C> <Action>(CodeCleanup)
" Go to class/type: Ctrl+T
map <C-T> <Action>(GotoClass)
" Find in file: Ctrl+F
map <C-F> <Action>(Find)
" Safe delete: Ctrl+R, D
map <C-R><C-D> <Action>(SafeDelete)
" Rename: Ctrl+R, R
map <C-R><C-R> <Action>(RenameElement)
